<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ChronTravelers.Server</AssemblyName>
    <Product>ChronTravelers Server</Product>
    <Version>0.1.0</Version>
    <Authors>Lüdinn Entertainment</Authors>
    <Company>Lüdinn Entertainment</Company>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LiteDB" Version="5.0.21" />
  </ItemGroup>

  <!-- Kestrel + SignalR server, without switching to the Web SDK. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChronTravelers.Core\ChronTravelers.Core.csproj" />
    <ProjectReference Include="..\ChronTravelers.Engine\ChronTravelers.Engine.csproj" />
    <ProjectReference Include="..\ChronTravelers.Game\ChronTravelers.Game.csproj" />
    <ProjectReference Include="..\ChronTravelers.Content\ChronTravelers.Content.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tier-free catalogs the timeline is built from (same trick as the
         console) — copied next to the exe under Content\ for ContentLoader. -->
    <Content Include="..\ChronTravelers.Content\*.json">
      <Link>Content\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Player-facing app identity (installer/ChronoTravelers.iss, exe file properties). -->
    <AssemblyName>ChronoTravelers</AssemblyName>
    <Product>Chrono Travelers</Product>
    <Version>0.1.1</Version>
    <Authors>Lüdinn Entertainment</Authors>
    <Company>Lüdinn Entertainment</Company>

    <!--
      Publish settings for the packaged Windows build — docs/TECH_STACK.md:
      "dotnet publish produces a self-contained single-file EXE." These are
      inert for plain `dotnet build`/`dotnet test`; they only take effect
      with `dotnet publish -r win-x64`, e.g.:
        dotnet publish src/ChronoTravelers.Console -c Release -r win-x64 -o publish/win-x64
      (see installer/ChronoTravelers.iss, which packages that output).
    -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="8.0.11" />
    <!-- Windows waveOut playback for AudioManager.cs (docs/AUDIO.md). -->
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- The "How to play" text shown from the start menu — embedded so it
         can't go missing next to a single-file exe. -->
    <EmbeddedResource Include="HowToPlay.txt" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChronoTravelers.Core\ChronoTravelers.Core.csproj" />
    <ProjectReference Include="..\ChronoTravelers.Engine\ChronoTravelers.Engine.csproj" />
    <ProjectReference Include="..\ChronoTravelers.Content\ChronoTravelers.Content.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      ChronoTravelers.Content has no compiled output to reference, so its JSON
      files don't flow through the ProjectReference above — copy them
      directly into our own output under Content\, where
      ChronoTravelers.Engine.Content.ContentLoader expects to find them (see
      Program.cs) and where the published single-file exe needs them
      alongside it (CopyToPublishDirectory) since they can't be bundled
      into the exe itself.
    -->
    <Content Include="..\ChronoTravelers.Content\*.json">
      <Link>Content\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!--
      Sound assets (docs/AUDIO.md) - WAV files can't be embedded/bundled
      into the single-file exe either, same reasoning as Content\*.json
      above: they sit next to it under Audio\, and AudioManager.cs reads
      them from AppContext.BaseDirectory\Audio at runtime. See
      installer/ChronoTravelers.iss for the packaged-install side of this.
    -->
    <Content Include="Audio\*.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!--
    Belt-and-braces for the packaged build. The .NET SDK's single-file
    publish pipeline reproducibly drops one Audio\*.wav - title_theme.wav,
    the largest by far - from its computed _ResolvedFileToPublish list, so
    the file silently never reaches publish\...\Audio\ and the installed
    game boots with no title theme. (The other six WAVs, all smaller, copy
    fine.) Re-copy the whole folder ourselves once publish is done:
    unconditional, idempotent, and independent of that flaky computed list.
    See installer/ChronoTravelers.iss (packaging side) and docs/AUDIO.md.
  -->
  <Target Name="ForceCopyAudioToPublishDir"
          AfterTargets="Publish"
          Condition="'$(PublishDir)' != ''">
    <ItemGroup>
      <_AllAudioWav Include="$(MSBuildProjectDirectory)\Audio\*.wav" />
    </ItemGroup>
    <Copy SourceFiles="@(_AllAudioWav)"
          DestinationFolder="$(PublishDir)Audio"
          SkipUnchangedFiles="false"
          OverwriteReadOnlyFiles="true" />
    <Message Importance="high"
             Text="ForceCopyAudioToPublishDir: ensured @(_AllAudioWav->Count()) Audio\*.wav file(s) in $(PublishDir)Audio" />
  </Target>

  <!--
    Same belt-and-braces for Content\*.json. An INCREMENTAL `dotnet publish
    -o <dir>` (nothing changed since the last one) cleans the output dir
    but then, judging the project up-to-date, skips re-copying the linked
    Content\*.json items above - leaving publish\...\Content\ empty and the
    installed game silently falling back to the tiny 3-era sandbox
    (ContentLoader in ChronoTravelers.Engine). Re-copy the folder ourselves
    after publish: unconditional and idempotent, exactly like the Audio
    target. See installer/ChronoTravelers.iss.
  -->
  <Target Name="ForceCopyContentToPublishDir"
          AfterTargets="Publish"
          Condition="'$(PublishDir)' != ''">
    <ItemGroup>
      <_AllContentJson Include="$(MSBuildProjectDirectory)\..\ChronoTravelers.Content\*.json" />
    </ItemGroup>
    <Copy SourceFiles="@(_AllContentJson)"
          DestinationFolder="$(PublishDir)Content"
          SkipUnchangedFiles="false"
          OverwriteReadOnlyFiles="true" />
    <Message Importance="high"
             Text="ForceCopyContentToPublishDir: ensured @(_AllContentJson->Count()) Content\*.json file(s) in $(PublishDir)Content" />
  </Target>

</Project>

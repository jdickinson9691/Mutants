<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Pulls in Core/Engine/Game/Content transitively, plus
      Microsoft.AspNetCore.App (via the Server project's own
      FrameworkReference) so SignalR's Hub/HubCallerContext/IHubContext
      types are available here for GameHubTests without this test project
      needing its own Web SDK switch.
    -->
    <ProjectReference Include="..\..\src\ChronoTravelers.Server\ChronoTravelers.Server.csproj" />
  </ItemGroup>

</Project>
